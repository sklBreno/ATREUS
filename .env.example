# Application identity
ATREUS_APP_NAME=ATREUS
ATREUS_VERSION=0.1.0-alpha
ATREUS_LANGUAGE=pt-BR

# Runtime behavior
ATREUS_DEBUG=true
ATREUS_LOG_LEVEL=INFO
ATREUS_WORKING_MEMORY_CAPACITY=64
ATREUS_WORKING_MEMORY_ENTRY_TTL_SECONDS=1800
ATREUS_AI_ENABLED=false
ATREUS_AI_PROVIDER=openai
ATREUS_AI_MODEL=
ATREUS_AI_TIMEOUT_SECONDS=30
ATREUS_OLLAMA_BASE_URL=http://localhost:11434
ATREUS_OLLAMA_MODEL=qwen3:8b
ATREUS_CONFIRMATION_TTL_SECONDS=120
ATREUS_PERMISSION_GRANTS=application.control,application.read

# System behavior
ATREUS_START_WITH_WINDOWS=true
ATREUS_ALWAYS_ON=true
